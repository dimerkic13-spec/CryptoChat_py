{
  "thresholds": {
    "answer": 0.65,
    "clarify": 0.3,
    "scopeMin": 0.1,
    "scopeMargin": 0.05,
    "dominanceGap": 0.2
  },
  "scoring": {
    "scopeBoost": 0.25,
    "prefixMinLength": 4,
    "categoryScope": false
  },
  "menu": {
    "maxOptions": 3
  },
  "support": {
    "url": "support.cryptopro.ru"
  },
  "logging": {
    "unanswered": false,
    "path": "logs/unanswered.jsonl",
    "feedback": true,
    "feedbackPath": "logs/feedback.jsonl"
  },
  "dialog": {
    "guided": true,
    "escalateAfterSteps": 4,
    "maxBranchOptions": 7,
    "minScore": 0.05,
    "feedback": true,
    "suggestScore": 0.05,
    "menuFillScore": 0.05,
    "browseOptions": true
  },
  "text": {
    "morphology": "auto"
  },
  "fuzzy": {
    "enabled": true,
    "threshold": 85,
    "minLength": 5,
    "weight": 0.8
  },
  "semantic": {
    "enabled": true,
    "model": "cointegrated/rubert-tiny2",
    "cacheDir": "models",
    "device": "cpu",
    "localFilesOnly": false,
    "mode": "relative",
    "zLow": 0.0,
    "zHigh": 5.0,
    "topK": 3,
    "low": 0.55,
    "high": 0.9,
    "weight": 0.3,
    "combine": "or",
    "queryPrefix": "",
    "passagePrefix": "",
    "menuFallback": true,
    "menuZ": 1.5,
    "menuSize": 3
  },
  "sessions": {
    "enabled": true,
    "path": "logs/sessions"
  },
  "database": {
    "enabled": true,
    "path": "logs/cryptochat.db"
  },
  "email": {
    "enabled": false,
    "smtpHost": "smtp.yandex.ru",
    "smtpPort": 465,
    "security": "ssl",
    "username": "bot@example.ru",
    "from": "bot@example.ru",
    "to": [
      "you@example.ru"
    ],
    "subjectPrefix": "CryptoChat",
    "passwordEnv": "CRYPTOCHAT_SMTP_PASSWORD",
    "sendEmpty": false,
    "sendPendingOnStart": true,
    "timeoutSeconds": 20
  }
}